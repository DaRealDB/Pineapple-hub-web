# OCR Pipeline Backend Configuration
# Loaded by backend/utils/config.py via pydantic-settings

# ── Server ─────────────────────────────────────────────────────────
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8000

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:123456@localhost:5432/ocr_pipeline

# ── MQTT Broker (Aedes in node-red/) ───────────────────────────────
# start-all.bat launches the broker on TCP port 1884 (not 1883!)
MQTT_BROKER_URL=mqtt://127.0.0.1:1884
MQTT_CLIENT_ID=python-ocr-backend

# ── OCR ────────────────────────────────────────────────────────────
OCR_ENGINE=easyocr
GPU_ENABLED=auto
CONFIDENCE_THRESHOLD=0.5
OCR_INTERVAL_SECONDS=1.0

# ── YOLO ───────────────────────────────────────────────────────────
YOLO_ENABLED=true
YOLO_WEIGHTS_PATH=weights/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IMAGE_SIZE=640

# ── Crate State Machine ────────────────────────────────────────────
CRATE_STATE_MACHINE_ENABLED=true
CRATE_LOG_COOLDOWN_MS=3000
CRATE_DATA_TTL_MS=10000
CRATE_AUTO_LOG_DELAY_SECONDS=5
EXPRESS_API_URL=http://localhost:3001
EXPRESS_API_TOKEN=

# ── Webcam ─────────────────────────────────────────────────────────
WEBCAM_DEVICE_INDEX=0
WEBCAM_WIDTH=640
WEBCAM_HEIGHT=480
WEBCAM_FPS=30
LIVE_VIEW_FPS=15
