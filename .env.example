# ── MQTT Broker (WebSocket) ────────────────────────────────────────
# The React app connects here for live telemetry.
# Use ws://127.0.0.1:9001 for local dev (Aedes broker in node-red/).
# Change to the IP of the machine running the broker in production.
VITE_MQTT_WS_URL=ws://127.0.0.1:9001

# ── Node-RED HTTP API ──────────────────────────────────────────────
# CSV exports and historical data queries (existing Node-RED instance).
VITE_NODE_RED_BASE_URL=http://localhost:1880

# ── OCR Pipeline Backend ───────────────────────────────────────────
# Python FastAPI server (backend/main.py).
VITE_OCR_WS_URL=ws://localhost:8000
VITE_OCR_API_URL=http://localhost:8000
