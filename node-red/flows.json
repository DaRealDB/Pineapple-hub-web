  {
    "id": "comment-setup",
    "type": "comment",
    "name": "Pineapple Hub — MQTT Seed Data Flow",
    "info": "Standalone Aedes broker runs via broker.js (ws://127.0.0.1:9001, mqtt://127.0.0.1:1883).\n\nScale data published every 2s to pineapple/scale1/data.\nAvailability published once on startup (retained).\nZone injectors let you manually toggle vision zones.\nSwitch commands from the app are echoed back as state updates.",
    "x": 180,
    "y": 20,
    "wires": []
  }
