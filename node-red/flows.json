  {
    "id": "comment-availability",
    "type": "comment",
    "name": "Scale Availability (retained, QoS 1)",
    "info": "Publishes \"online\" on startup so the app sees the scale as available.\nRetained — survives client disconnects.",
    "x": 180,
    "y": 180,
    "wires": []
  },
  {
    "id": "inject-availability",
    "type": "inject",
    "name": "Startup: scale online",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "payload": "online",
    "payloadType": "str",
    "topic": "",
    "x": 180,
    "y": 240,
    "wires": [["mqtt-out-availability"]]
  },
  {
    "id": "mqtt-out-availability",
    "type": "mqtt out",
    "name": "pineapple/scale1/availability",
    "topic": "pineapple/scale1/availability",
    "qos": "1",
    "retain": true,
    "broker": "mqtt-broker-config",
    "x": 520,
    "y": 240,
    "wires": []
  },
  {
    "id": "comment-scale-data",
    "type": "comment",
    "name": "Scale Weight Data (QoS 1, every 2s)",
    "info": "Simulates a weigh scale publishing crate weights.\nweight_g: 12–16 kg range (crate-scale per forge.md).\ngrade: placeholder.\nstatus.hx711_fault: false (no fault).",
    "x": 180,
    "y": 320,
    "wires": []
  },
  {
    "id": "inject-scale-data",
    "type": "inject",
    "name": "Every 2s",
    "props": [{ "p": "payload" }],
    "repeat": "2",
    "crontab": "",
    "once": false,
    "payload": "tick",
    "payloadType": "str",
    "topic": "",
    "x": 180,
    "y": 380,
    "wires": [["func-gen-weight"]]
  },
  {
    "id": "func-gen-weight",
    "type": "function",
    "name": "Generate crate weight",
    "func": "// Simulate a crate on the scale: ~12-16 kg with jitter\nconst baseWeight = 14000 + Math.sin(Date.now() / 5000) * 2000;\nconst jitter = (Math.random() - 0.5) * 200;\nconst weightG = Math.round(baseWeight + jitter);\n\n// Placeholder grade — forge.md §2: real formula TBD\nconst grades = ['Grade 1', 'Grade 1', 'Grade 1', 'Light', 'Heavy'];\nconst grade = grades[Math.floor(Math.random() * grades.length)];\n\nconst payload = {\n    weight_g: weightG,\n    grade: grade,\n    status: {\n        hx711_fault: false,\n        eth_or_wifi_issue: false\n    },\n    ts: Date.now()\n};\n\nmsg.payload = JSON.stringify(payload);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 380,
    "wires": [["mqtt-out-scale-data"]]
  },
  {
    "id": "mqtt-out-scale-data",
    "type": "mqtt out",
    "name": "pineapple/scale1/data",
    "topic": "pineapple/scale1/data",
    "qos": "1",
    "retain": false,
    "broker": "mqtt-broker-config",
    "x": 680,
    "y": 380,
    "wires": []
  },
  {
