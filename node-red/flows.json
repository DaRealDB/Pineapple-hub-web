  {
    "id": "comment-switches",
    "type": "comment",
    "name": "HMI Switches (forge.md §4)",
    "info": "Switch Panel on the Device Management screen publishes to pineapple/hmi/{switchId}/set.\nThis flow echoes back state changes so the panel stays in sync.",
    "x": 180,
    "y": 700,
    "wires": []
  },
  {
    "id": "mqtt-in-switch-cmd",
    "type": "mqtt in",
    "name": "Switch commands",
    "topic": "pineapple/hmi/+/set",
    "qos": "1",
    "broker": "mqtt-broker-config",
    "x": 180,
    "y": 770,
    "wires": [["func-echo-switch", "debug-switch-cmd"]]
  },
  {
    "id": "func-echo-switch",
    "type": "function",
    "name": "Echo as state",
    "func": "// Extract switchId from topic: pineapple/hmi/{switchId}/set\nconst parts = msg.topic.split('/');\nconst switchId = parts[2];\n\n// Republish as state: pineapple/hmi/{switchId}/state\nmsg.topic = `pineapple/hmi/${switchId}/state`;\n// payload is already \"on\" or \"off\" — pass through\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 770,
    "wires": [["mqtt-out-switch-state"]]
  },
  {
    "id": "mqtt-out-switch-state",
    "type": "mqtt out",
    "name": "pineapple/hmi/+/state",
    "topic": "",
    "qos": "1",
    "retain": false,
    "broker": "mqtt-broker-config",
    "x": 700,
    "y": 770,
    "wires": []
  },
  {
    "id": "inject-switch1-on",
    "type": "inject",
