  {
    "id": "func-gen-weight",
    "type": "function",
    "name": "Generate crate weight (seed)",
    "func": "// Simulate a crate on the scale: ~12-16 kg with jitter\nconst baseWeight = 14000 + Math.sin(Date.now() / 5000) * 2000;\nconst jitter = (Math.random() - 0.5) * 200;\nconst weightG = Math.round(baseWeight + jitter);\n\n// Placeholder grade — forge.md §2: real formula TBD\nconst grades = ['Grade 1', 'Grade 1', 'Grade 1', 'Light', 'Heavy'];\nconst grade = grades[Math.floor(Math.random() * grades.length)];\n\nconst payload = {\n    weight_g: weightG,\n    grade: grade,\n    status: {\n        hx711_fault: false,\n        eth_or_wifi_issue: false\n    },\n    ts: Date.now()\n};\n\nmsg.payload = JSON.stringify(payload);\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 240,
    "wires": [["mqtt-out-scale-data"]]
  },
  {
    "id": "mqtt-out-scale-data",
    "type": "mqtt out",
    "name": "pineapple/scale1/data",
    "topic": "pineapple/scale1/data",
    "qos": "1",
    "retain": false,
    "broker": "mqtt-broker-config",
    "x": 720,
    "y": 240,
    "wires": []
  },
