  {
    "id": "comment-switches",
    "type": "comment",
    "name": "━━━ HMI Switches (forge.md §4) ━━━",
    "info": "The web app's Switch Panel (Device Management screen) publishes commands\nto pineapple/hmi/{switchId}/set. This flow echoes them back as state updates\non pineapple/hmi/{switchId}/state so the panel shows the confirmed state.\n\nIn production with real hardware, the ESP32 or a PLC would publish the\nactual physical switch state — remove the echo function and let hardware\ndrive it.",
    "x": 180,
    "y": 780,
    "wires": []
  },
  {
    "id": "mqtt-in-switch-cmd",
    "type": "mqtt in",
    "name": "Switch commands (from app)",
    "topic": "pineapple/hmi/+/set",
    "qos": "1",
    "broker": "mqtt-broker-config",
    "x": 180,
    "y": 850,
    "wires": [["func-echo-switch", "debug-switch-cmd"]]
  },
  {
    "id": "func-echo-switch",
    "type": "function",
    "name": "Echo as state",
    "func": "// Extract switchId from topic: pineapple/hmi/{switchId}/set\nconst parts = msg.topic.split('/');\nconst switchId = parts[2];\n\n// Republish as state: pineapple/hmi/{switchId}/state\nmsg.topic = `pineapple/hmi/${switchId}/state`;\n// payload is already \"on\" or \"off\" — pass through\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 850,
    "wires": [["mqtt-out-switch-state"]]
  },
