    "id": "mqtt-out-switch-state",
    "type": "mqtt out",
    "name": "pineapple/hmi/+/state",
    "topic": "",
    "qos": "1",
    "retain": false,
    "broker": "mqtt-broker-config",
    "x": 700,
    "y": 850,
    "wires": []
  },
